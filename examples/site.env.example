# Copy to an untracked file (e.g. site/cluster.env) and pass it as SITE_ENV=... to examples/slurm_demo.sh.
# Everything a particular machine needs before the demo can start vLLM goes here.

# a virtualenv that has vLLM built for this machine (queryplan itself is put on PYTHONPATH by the script)
source /path/to/venv-with-vllm/bin/activate

# where model weights are cached; offline, because many jobs asking the Hub at once get rate-limited
export HF_HOME=/path/to/scratch/hf HF_HUB_OFFLINE=1

# some vLLM builds compile FlashInfer's sampler on first use, which needs nvcc on the compute node
export VLLM_USE_FLASHINFER_SAMPLER=0

# gpt-oss style tokenizers fetch their vocabulary on first use; point at a pre-fetched copy
export TIKTOKEN_ENCODINGS_BASE=$HF_HOME/tiktoken_encodings

# GPU type label for the cost model, and GPU memory in GB
export PYTHON=python HW=GH200-96GB MEM=96

# serve models straight from a local Hugging Face hub cache (no hub lookups); useful on shared, incomplete caches
# export EXTRA_ARGS="--local-snapshots /path/to/hf/hub"
